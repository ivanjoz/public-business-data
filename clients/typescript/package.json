{
  "name": "@ivanjoz/public-business-data",
  "version": "0.1.0",
  "description": "Cliente de los datasets binarios publicados en public-business-data.un.pe (tipo de cambio SUNAT y tipo de cambio interbancario BCRP).",
  "type": "module",
  "main": "./dist/client.mjs",
  "module": "./dist/client.mjs",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.mjs"
    },
    "./src": "./src/index.ts"
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "scripts": {
    "build": "bun run build.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivanjoz/public-business-data.git",
    "directory": "clients/typescript"
  }
}
